# name: test/sql/composed.test
# description: composed example queries combining several sigma objects (mirrors vgi_sigma/composed.py)
# group: [vgi_sigma]

require-env VGI_SIGMA_WORKER

statement ok
LOAD vgi;

# json_extract (missing-fields example) lives in the json extension.
statement ok
LOAD json;

statement ok
ATTACH 'sigma' AS sigma (TYPE vgi, LOCATION '${VGI_SIGMA_WORKER}');

# sigma_check + sigma_match: rule library hunt (cidr rule skipped)
query II
WITH rules(rule_name, rule) AS (VALUES ('encoded_powershell', '{title: Encoded PowerShell, level: high, logsource: {product: windows, category: process_creation}, detection: {selection: {Image|endswith: \powershell.exe, CommandLine|contains: " -enc "}, condition: selection}}'), ('failed_network_logon', '{title: Failed Network Logon, level: medium, logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}'), ('ssh_to_internal_net', '{title: SSH To Internal Network, level: low, logsource: {category: network_connection}, detection: {selection: {DestinationIp|cidr: 10.0.0.0/8, DestinationPort: 22}, condition: selection}}')), logs(event_id, event) AS (VALUES (1, '{"EventID": 4625, "LogonType": 3, "TargetUserName": "admin"}'), (2, '{"EventID": 4625, "LogonType": 2, "TargetUserName": "alice"}'), (3, '{"EventID": 1, "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "CommandLine": "powershell.exe -nop -enc SQBFAFgA"}'), (4, '{"EventID": 1, "Image": "C:\\Windows\\explorer.exe", "CommandLine": "explorer.exe"}')), usable AS (SELECT rule_name, rule FROM rules WHERE sigma.main.sigma_check(rule)) SELECT l.event_id, u.rule_name FROM logs AS l JOIN usable AS u ON sigma.main.sigma_match(l.event, u.rule) ORDER BY l.event_id, u.rule_name;
----
1	failed_network_logon
3	encoded_powershell

# sigma_rule_info + sigma_match: alert enrichment
query IIII
WITH logs(event_id, event) AS (VALUES (1, '{"EventID": 4625, "LogonType": 3, "TargetUserName": "admin"}'), (2, '{"EventID": 4624, "LogonType": 3, "TargetUserName": "admin"}'), (3, '{"EventID": 4625, "LogonType": 3, "TargetUserName": "svc_backup"}')) SELECT l.event_id, i.title, i.level, i.tags FROM logs AS l CROSS JOIN sigma.main.sigma_rule_info('{title: Failed Network Logon, level: medium, tags: [attack.credential_access, attack.t1110], logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}') AS i WHERE sigma.main.sigma_match(l.event, '{title: Failed Network Logon, level: medium, tags: [attack.credential_access, attack.t1110], logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}') ORDER BY l.event_id;
----
1	Failed Network Logon	medium	[attack.credential_access, attack.t1110]
3	Failed Network Logon	medium	[attack.credential_access, attack.t1110]

# sigma_match_fields + sigma_match: no-match vs. blind spot
query III
WITH logs(host, event) AS (VALUES ('dc01', '{"EventID": 4625, "LogonType": 3, "TargetUserName": "admin"}'), ('ws17', '{"EventID": 4625, "TargetUserName": "bob"}'), ('fw02', '{"action": "deny", "dst_port": 3389}')) SELECT l.host, sigma.main.sigma_match(l.event, '{title: Failed Network Logon, level: medium, tags: [attack.credential_access, attack.t1110], logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}') AS matched, coalesce(list(f.field ORDER BY f.field) FILTER (WHERE json_extract(l.event, '$.' || f.field) IS NULL), []) AS missing_fields FROM logs AS l CROSS JOIN sigma.main.sigma_match_fields('{title: Failed Network Logon, level: medium, tags: [attack.credential_access, attack.t1110], logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}') AS f GROUP BY l.host, l.event ORDER BY l.host;
----
dc01	true	[]
fw02	false	[EventID, LogonType]
ws17	false	[LogonType]

# supported_modifiers + sigma_check: why a rule is rejected
query II
WITH rules(rule_name, rule) AS (VALUES ('encoded_powershell', '{title: Encoded PowerShell, level: high, logsource: {product: windows, category: process_creation}, detection: {selection: {Image|endswith: \powershell.exe, CommandLine|contains: " -enc "}, condition: selection}}'), ('failed_network_logon', '{title: Failed Network Logon, level: medium, logsource: {product: windows, service: security}, detection: {selection: {EventID: 4625, LogonType: 3}, condition: selection}}'), ('ssh_to_internal_net', '{title: SSH To Internal Network, level: low, logsource: {category: network_connection}, detection: {selection: {DestinationIp|cidr: 10.0.0.0/8, DestinationPort: 22}, condition: selection}}')), used AS (SELECT rule_name, unnest(regexp_extract_all(rule, '\|(\w+)', 1)) AS modifier FROM rules WHERE NOT sigma.main.sigma_check(rule)) SELECT rule_name, list(DISTINCT modifier ORDER BY modifier) AS unsupported_modifiers FROM used WHERE modifier NOT IN (SELECT modifier FROM sigma.main.supported_modifiers) GROUP BY rule_name ORDER BY rule_name;
----
ssh_to_internal_net	[cidr]

statement ok
DETACH sigma;
